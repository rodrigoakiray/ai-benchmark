{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./credentials.json)",
      "Read(./token.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./credentials.json)",
      "Edit(./token.json)",
      "Edit(./.gitignore)",
      "Edit(./raw/**)",
      "Bash(*cat *.env*)",
      "Bash(*cat *credentials.json*)",
      "Bash(*cat *token.json*)",
      "Bash(*git add* -f*)",
      "Bash(*git add* -Af*)",
      "Bash(*git add* -fA*)",
      "Bash(*git add* --force*)",
      "Bash(*git push* -f*)",
      "Bash(*git push* --force*)",
      "Bash(*git commit* --no-verify*)",
      "Bash(*git commit* -n *)",
      "Bash(*> .gitignore*)",
      "Bash(*>.gitignore*)",
      "Bash(*sed -i*.gitignore*)",
      "Bash(*rm *raw/*)",
      "Bash(*mv *raw/*)",
      "Bash(*> raw/*)",
      "Bash(*rm *datalake/*)",
      "Bash(*mv *datalake/*)"
    ]
  }
}
